from turtle import *
from city import *
speed(0)
color('light blue')
penup()
goto(-240, 30)
pendown()
begin_fill()
for i in range(4):
    forward(480)
    left(90)
end_fill()

color('light green')
begin_fill()
for i in range(4):
    forward(480)
    right(90)
end_fill()

penup()
goto(0, 0)
pendown()

color('black', 'grey')
draw_home()
color('orange, yellow')
draw_windows_x_y()

penup()
goto(-100, -40)
pendown
tree()

penup()
goto(-200, 150)
pendown()
sun()
exitonclick()
